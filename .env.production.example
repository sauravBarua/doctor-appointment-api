# ---- read by docker compose (use URL-safe passwords: letters and digits only) ----
DOMAIN=api.example.com
POSTGRES_USER=doctor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=doctor_booking
RABBITMQ_USER=rabbit
RABBITMQ_PASSWORD=change-me

# ---- app: copy the remaining keys from .env.example with production values ----
NODE_ENV=production
PORT=3000
TRUST_PROXY_HOPS=1
FRONTEND_URL=https://your-frontend.example.com
# Set your Better Auth base URL and Google redirect URI to https://<DOMAIN>/...
# Use a real SMTP provider (Resend, Brevo, Mailgun), not Gmail.
# DATABASE_URL, REDIS_URL, RABBITMQ_URL are injected by compose; you can delete them here.